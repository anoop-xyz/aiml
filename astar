def a_star(graph, h, start, goal):
    open_set = {start}
    closed_set = set()

    g = {start: 0}
    parent = {start: None}

    while open_set:
        n = min(open_set, key=lambda x: g[x] + h[x])

        if n == goal:
            path = []
            while n is not None:
                path.append(n)
                n = parent[n]
            path.reverse()
            return path

        open_set.remove(n)
        closed_set.add(n)

        for m, cost in graph[n]:
            new_cost = g[n] + cost

            if new_cost < g.get(m, float("inf")):
                g[m] = new_cost
                parent[m] = n
                open_set.add(m)
                closed_set.discard(m)

    return "Path not found"


